# Salin ke .env lalu sesuaikan. File .env tidak di-commit.

# development | production — seeder data dummy menolak jalan di production
APP_ENV=development
TZ=Asia/Makassar

# Database
POSTGRES_USER=cuti
POSTGRES_PASSWORD=cuti_dev
POSTGRES_DB=cuti_esdm
DB_PORT=5432
DATABASE_URL=postgresql://cuti:cuti_dev@localhost:5432/cuti_esdm

# Gotenberg (PDF & konversi dokumen)
GOTENBERG_URL=http://localhost:3100

# Penyimpanan berkas unggahan (di luar folder public)
STORAGE_DIR=./.data/berkas
# Kunci AES-256-GCM untuk dokumen pribadi: 64 karakter hex.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BERKAS_KUNCI=df11eda589eb33836c484123953fd29cbbff38d0227ecbb1984beb634f2e1680

# URL aplikasi (dipakai untuk tautan di email & cek Origin)
APP_URL=http://localhost:3000

# SMTP (opsional). Kosongkan SMTP_HOST untuk menonaktifkan email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Absensi & Cuti ESDM Kalsel <no-reply@example.go.id>"

# Seeder data dummy (HANYA development). Semua akun dummy memakai password ini.
SEED_PASSWORD_DEV=Rahasia123

TUGAS_TOKEN=bec92a1100a761d37fc118001a74a07fdc78930ffdf1229c
