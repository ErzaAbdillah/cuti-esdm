# Salin ke .env.production di server, isi semua nilai, JANGAN di-commit.
APP_ENV=production
TZ=Asia/Makassar
NODE_ENV=production

POSTGRES_USER=cuti
POSTGRES_PASSWORD=
POSTGRES_DB=cuti_esdm
DATABASE_URL=postgresql://cuti:GANTI_PASSWORD@db:5432/cuti_esdm

# URL publik (HTTPS) — cookie sesi memakai prefix __Host- bila https.
APP_URL=https://cuti.esdm.kalselprov.go.id

# 64 hex: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SIMPAN SALINANNYA DI TEMPAT AMAN TERPISAH DARI BACKUP — tanpa kunci ini dokumen pribadi tidak bisa dibuka.
BERKAS_KUNCI=
# Minimal 24 karakter acak.
TUGAS_TOKEN=

# Masuk dengan Google (opsional). Redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Layanan Cuti ESDM Kalsel <no-reply@esdm.kalselprov.go.id>"

# Backup
BACKUP_DIR=./backups
RETENSI_HARI=14
JAM_BACKUP=01
